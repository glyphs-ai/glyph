{
  "name": "@glyphs-ai/cli",
  "version": "0.0.1",
  "description": "Command-line interface for glyph (lifecycle commands + HTTP API client)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@glyphs-ai/contracts": "workspace:*",
    "@glyphs-ai/server": "workspace:*",
    "commander": "^12.1.0",
    "write-file-atomic": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/write-file-atomic": "^4.0.3",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/glyphs-ai/glyph.git",
    "directory": "packages/cli"
  }
}
