{
  "name": "@glyphs-ai/api",
  "version": "0.0.1",
  "description": "Application layer for glyph: orchestration of T0/T1 packages into a composable runtime. Re-exports `@glyphs-ai/contracts` so server has a single import site; dashboard / cli should depend on `@glyphs-ai/contracts` directly.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@glyphs-ai/catalog": "workspace:*",
    "@glyphs-ai/contracts": "workspace:*",
    "@glyphs-ai/runtime": "workspace:*",
    "@glyphs-ai/schedule": "workspace:*",
    "@glyphs-ai/session": "workspace:*",
    "@glyphs-ai/task": "workspace:*",
    "@glyphs-ai/terminal": "workspace:*",
    "@glyphs-ai/workflow": "workspace:*",
    "@glyphs-ai/workspace": "workspace:*",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/glyphs-ai/glyph.git",
    "directory": "packages/api"
  }
}
