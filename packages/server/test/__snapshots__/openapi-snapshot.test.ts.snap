                  },
                  "required": [
                    "installed",
                    "skipped",
                    "failed",
                    "conflicts",
                    "orphansFlagged",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Sync result",
          },
          "400": {
            "description": "Malformed request body",
          },
          "410": {
            "description": "Plan token expired or already applied",
          },
          "500": {
            "description": "Internal error",
          },
        },
        "summary": "Apply a skill sync",
        "tags": [
          "catalog",
        ],
      },
    },
