    "/api/workspaces/{id}/scheduled-tasks": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "agent",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "createdSince",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "runtime",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "enum": [
                "running",
                "succeeded",
                "failed",
                "cancelled",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "scheduleId",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "properties": {
                      "agent": {
                        "type": "string",
                      },
                      "brief": {
                        "type": "string",
                      },
                      "cancellation": {
                        "oneOf": [
                          {
                            "properties": {
                              "kind": {
                                "enum": [
                                  "user",
                                ],
                                "type": "string",
                              },
                              "message": {
                                "type": "string",
                              },
                            },
                            "required": [
                              "kind",
                              "message",
                            ],
                            "type": "object",
                          },
                          {
                            "properties": {
                              "kind": {
                                "enum": [
                                  "cascade",
                                ],
                                "type": "string",
                              },
                              "message": {
                                "type": "string",
                              },
                            },
                            "required": [
                              "kind",
                              "message",
                            ],
                            "type": "object",
                          },
                        ],
                      },
                      "createdAt": {
                        "type": "string",
                      },
                      "details": {
                        "type": "string",
                      },
                      "endedAt": {
                        "type": "string",
                      },
                      "failure": {
                        "oneOf": [
                          {
                            "properties": {
                              "exitCode": {
                                "type": "number",
                              },
                              "kind": {
                                "enum": [
                                  "execution",
                                ],
                                "type": "string",
                              },
                              "message": {
                                "type": "string",
                              },
                              "signal": {
                                "type": "string",
                              },
                            },
                            "required": [
                              "kind",
                              "message",
                            ],
                            "type": "object",
                          },
                          {
                            "properties": {
                              "kind": {
                                "enum": [
                                  "internal",
                                ],
                                "type": "string",
                              },
                              "message": {
                                "type": "string",
                              },
                            },
                            "required": [
                              "kind",
                              "message",
                            ],
                            "type": "object",
                          },
                          {
                            "properties": {
                              "kind": {
                                "enum": [
                                  "cascade",
                                ],
                                "type": "string",
                              },
                              "message": {
                                "type": "string",
                              },
                            },
                            "required": [
                              "kind",
                              "message",
                            ],
                            "type": "object",
                          },
                        ],
                      },
                      "id": {
                        "pattern": "^\\d{8}-[0-9a-f]{8}$",
                        "type": "string",
                      },
                      "metadata": {
                        "additionalProperties": {},
                        "type": "object",
                      },
                      "origin": {
                        "type": "string",
                      },
                      "originId": {
                        "type": "string",
                      },
                      "startedAt": {
                        "type": "string",
                      },
                      "status": {
                        "enum": [
                          "running",
                          "succeeded",
                          "failed",
                          "cancelled",
                        ],
                        "type": "string",
                      },
                      "success": {
                        "properties": {
                          "artifacts": {
                            "items": {
                              "type": "string",
                            },
                            "type": "array",
                          },
                          "output": {
                            "type": [
                              "string",
                              "null",
                            ],
                          },
                        },
                        "required": [
                          "output",
                        ],
                        "type": "object",
                      },
                    },
                    "required": [
                      "id",
                      "agent",
                      "brief",
                      "origin",
                      "status",
                      "metadata",
                      "createdAt",
                      "startedAt",
                    ],
                    "type": "object",
                  },
                  "type": "array",
                },
              },
            },
            "description": "Tasks",
          },
          "400": {
            "description": "Malformed query",
          },
          "500": {
            "description": "Internal error",
          },
        },
        "summary": "List schedule-launched tasks",
        "tags": [
          "scheduled-tasks",
        ],
      },
    },
