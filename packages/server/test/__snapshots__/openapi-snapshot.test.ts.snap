                                ],
                                "type": "string",
                              },
                              "message": {
                                "type": "string",
                              },
                            },
                            "required": [
                              "kind",
                              "message",
                            ],
                            "type": "object",
                          },
                        ],
                      },
                      "id": {
                        "pattern": "^\\d{8}-[0-9a-f]{8}$",
                        "type": "string",
                      },
