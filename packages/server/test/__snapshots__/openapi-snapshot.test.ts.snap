                                ],
                                "type": "string",
                              },
                              "message": {
                                "type": "string",
                              },
                            },
                            "required": [
                              "kind",
                              "message",
                            ],
                            "type": "object",
                          },
                          {
                            "properties": {
                              "kind": {
                                "enum": [
