                            "type": "string",
                          },
                          "kind": {
                            "enum": [
                              "skill",
                              "agent",
                              "mcp",
                            ],
                            "type": "string",
                          },
                        },
                        "required": [
                          "kind",
                          "fqn",
                          "error",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "installed": {
                      "items": {
                        "properties": {
                          "fqn": {
                            "type": "string",
                          },
                          "kind": {
                            "enum": [
                              "skill",
                              "agent",
                              "mcp",
                            ],
                            "type": "string",
                          },
                          "prereqs": {
                            "type": "string",
                          },
                          "prereqsAck": {
                            "type": "boolean",
                          },
                        },
                        "required": [
                          "kind",
                          "fqn",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "orphansFlagged": {
                      "items": {
                        "properties": {
                          "fqn": {
                            "type": "string",
                          },
                          "kind": {
                            "enum": [
                              "skill",
                              "mcp",
                            ],
                            "type": "string",
                          },
                          "origin": {
                            "type": "string",
                          },
                        },
                        "required": [
                          "kind",
                          "fqn",
                          "origin",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "skipped": {
                      "items": {
                        "properties": {
                          "fqn": {
                            "type": "string",
                          },
                          "kind": {
                            "enum": [
                              "skill",
                              "agent",
                              "mcp",
                            ],
                            "type": "string",
                          },
                          "reason": {
                            "enum": [
                              "already-installed",
                              "up-to-date",
                              "dep-failed",
